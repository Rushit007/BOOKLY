# ============================================================
# BOOKLY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in real values. NEVER commit .env to version control.
# ============================================================

# APPLICATION
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# DATABASE (PostgreSQL)
POSTGRES_USER=bookly_user
POSTGRES_PASSWORD=bookly_password
POSTGRES_DB=bookly_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://bookly_user:bookly_password@localhost:5432/bookly_db?schema=public"

# AUTHENTICATION (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# REDIS CACHE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RAZORPAY PAYMENT GATEWAY (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CLOUD OBJECT STORAGE (S3/Cloudinary/Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=bookly-covers
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
